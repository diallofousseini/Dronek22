rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction utilitaire : Vérifie si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Règles globales par défaut : Rejeter tout ce qui n'est pas explicitement autorisé
    match /{document=**} {
      allow read, write: if false;
    }

    // Collections publiques en lecture (Contenu du site)
    match /projects/{document} { allow read: if true; allow write: if isAuthenticated(); }
    match /news/{document} { allow read: if true; allow write: if isAuthenticated(); }
    match /team/{document} { allow read: if true; allow write: if isAuthenticated(); }
    match /production_sites/{document} { allow read: if true; allow write: if isAuthenticated(); }
    match /services/{document} { allow read: if true; allow write: if isAuthenticated(); }
    match /service_configs/{document} { allow read: if true; allow write: if isAuthenticated(); }

    // Collection des contacts et consultations (Formulaires publics)
    match /contacts/{document} {
      allow create: if true; 
      allow read, update, delete: if isAuthenticated();
    }
    match /consultations/{document} {
      allow create: if true; 
      allow read, update, delete: if isAuthenticated();
    }

    // Règle de secours pour éviter les blocages sur de nouvelles collections de contenu
    match /{collectionName}/{document} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
